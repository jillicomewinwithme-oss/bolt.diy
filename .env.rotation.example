# ======================================
# API Key Rotation Configuration
# ======================================
# Copy this to your .env.local to enable API key rotation
# All API keys are optional - add only the providers you have keys for

# ======================================
# API KEY ROTATION SETTINGS
# ======================================

# Enable/disable API key rotation
VITE_API_ROTATION_ENABLED=true

# Rotation strategy: 'round-robin', 'least-used', 'random', or 'priority'
VITE_ROTATION_STRATEGY=least-used

# Priority order for providers (comma-separated)
# Only used if VITE_ROTATION_STRATEGY=priority
VITE_ROTATION_PRIORITY=Groq,OpenRouter,Cerebras

# Error threshold before disabling a provider (circuit breaker)
VITE_CIRCUIT_BREAKER_THRESHOLD=5

# Retry attempts for failed requests
VITE_ROTATION_RETRY_ATTEMPTS=3

# ======================================
# PROVIDER API KEYS
# ======================================

# Groq - Ultra-fast LLM inference
# Free tier: 30 RPM, 14,400 RPD
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - Multi-provider router with free models
# Free tier: 20 RPM, 200 RPD for free models
# Get key from: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Cerebras - High-performance inference
# Free tier: 30 RPM, 1M tokens/day
# Get key from: https://cloud.cerebras.ai/settings
CEREBRAS_API_KEY=

# Hugging Face - Community models
# Free tier: ~$0.10/month free credits
# Get key from: https://huggingface.co/settings/tokens
HuggingFace_API_KEY=

# Mistral AI - Open-weight models
# Free tier: ~1B tokens/month
# Get key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# Cohere - Commercial LLM provider
# Free tier: 1,000 API calls/month
# Get key from: https://dashboard.cohere.ai/api-keys
COHERE_API_KEY=

# Google Gemini - Google's generative AI
# Free tier: 10 RPM, 250 RPD (US only)
# Get key from: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ======================================
# METRICS & MONITORING
# ======================================

# Enable metrics collection
VITE_METRICS_COLLECTION_ENABLED=true

# Log metrics to console
VITE_LOG_METRICS_TO_CONSOLE=false

# Export metrics interval (ms)
VITE_METRICS_EXPORT_INTERVAL=300000
